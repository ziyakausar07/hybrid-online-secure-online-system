# Backend Node gateway environment variables

# Java backend base URL for all /backend requests
JAVA_BACKEND_URL=http://your-java-host:7070/backend

# JWT configuration
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
JWT_ISSUER=hybrid-voting-gateway
JWT_AUD=hybrid-voting-client

# Session secret for express-session; use a different value from JWT_SECRET if desired
SESSION_SECRET=replace_with_a_different_secret

# CORS origin whitelist (comma-separated)
CORS_ORIGIN=http://localhost:3000

# MySQL DB connection settings for the Node gateway DB client
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=voting_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_CONNECTION=localhost
